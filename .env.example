# =============================================================================
# MyPaisaa bank statement fetch pipeline configuration
# (backend/scripts/mypaisaa_fetch) — copy relevant lines into your .env
#
# No secrets are required: the MyPaisaa API is protected by IP whitelisting
# (see Muralikrishna's email — 123.201.8.65 / 171.50.245.234), not credentials.
# =============================================================================

# API endpoint (defaults shown; override only if MyPaisaa changes the URL)
# MYPAAISA_API_BASE_URL=https://vg1ypu45sc.execute-api.ap-south-1.amazonaws.com
# MYPAAISA_API_STATEMENTS_PATH=/fetchaccount/customerbankdetails/{userid}

# Input list of user IDs (CSV or XLSX; column header "user_id" recommended)
# MYPAAISA_INPUT_FILE=New Dataset/users.csv

# Where statements, manifest.db and reports are written (gitignored)
# MYPAAISA_OUTPUT_DIR=New Dataset/bank_statements

# Concurrency + pacing — keep low to avoid overloading the MyPaisaa API
# MAX_CONCURRENT_USERS=5
# REQUESTS_PER_SECOND=0        # 0 = unlimited (concurrency still applies)

# Retry policy (exponential backoff: base * 2^attempt, capped at max)
# MAX_RETRIES=3
# BACKOFF_BASE_SECONDS=2
# BACKOFF_MAX_SECONDS=60

# HTTP timeouts (seconds)
# REQUEST_TIMEOUT_SECONDS=60
# CONNECT_TIMEOUT_SECONDS=15
