# Normalize line endings: the repository stores LF.
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.conf text eol=lf
# Windows scripts stay CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
